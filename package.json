{
  "name": "planner-api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=24.19.0 <25"
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/server.ts",
    "start": "tsx --env-file-if-exists=.env src/server.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "format": "prettier --write src tests"
  },
  "dependencies": {
    "@date-fns/tz": "1.5.0",
    "@supabase/supabase-js": "2.118.0",
    "zod": "4.6.7",
    "tsx": "4.23.15"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.11",
    "@types/node": "24.19.2",
    "typescript": "7.0.2",
    "vitest": "5.0.5",
    "prettier": "3.9.10"
  }
}
